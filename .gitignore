# Logs
# Ignore all log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and Build Outputs
node_modules/           # Ignore node_modules directory (no need for /node_modules twice)
dist/                  # Ignore distribution folder
dist-ssr/              # Ignore server-side rendering distribution folder
*.local                # Ignore local config files

# Editor and IDE Files
.vscode/*              # Ignore all VS Code settings except extensions.json
!.vscode/extensions.json  # Explicitly include extensions.json
.idea/                 # Ignore IntelliJ IDEA files
.DS_Store              # Ignore macOS Finder metadata files
*.suo                  # Ignore Visual Studio solution user options
*.ntvs*                # Ignore Visual Studio telemetry files
*.njsproj              # Ignore Node.js project files for Visual Studio
*.sln                  # Ignore Visual Studio solution files
*.sw?                  # Ignore temporary swap files